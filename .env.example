# Application secret used to sign admin sessions and other security-sensitive values.
SECRET_KEY=replace-this-with-a-long-random-production-secret
# Database URL defaults to SQLite but can be changed to PostgreSQL in production.
DATABASE_URL=sqlite:///./aamac.db
# The initial administrator username created by the seed command.
ADMIN_USERNAME=admin
# The initial administrator password that must be changed after first login.
ADMIN_PASSWORD=ChangeMe123!
# Application environment controls development versus production behavior.
APP_ENV=development
# Optional host value used when running Uvicorn directly.
HOST=127.0.0.1
# Optional port value used when running Uvicorn directly.
PORT=8000
